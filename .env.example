# Text2SQL 环境变量示例
# 复制为 .env 后按需修改。不要把真实密钥提交到仓库。

# ==================== 基础 / Flask ====================
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# SECRET_KEY=change-me-to-a-long-random-string
APP_SESSION_HOURS=12

# ==================== 登录 / 认证 ====================
# 登录库名；AUTH_DB_NAME 优先，APP_AUTH_DB_NAME 兼容旧写法
AUTH_DB_NAME=hologres
# APP_AUTH_DB_NAME=hologres

# admin 引导账号：启动时会先写入/更新 knowledge.app_user
APP_ADMIN_ID=1
APP_ADMIN_ACCOUNT=admin
APP_ADMIN_USER_NAME=admin
APP_ADMIN_MOBILE=
APP_ADMIN_ROLE_ID=1
APP_ADMIN_ROLE_NAME=超级管理员
APP_ADMIN_PASSWORD=change-me
# 也可以直接给哈希值：
# APP_ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...

# 哪些角色/账号可查看全部数据
APP_ADMIN_ROLE_IDS=1
APP_SUPER_ADMIN_IDS=1

# ==================== 账号同步 ====================
APP_USER_SYNC_ENABLED=1
APP_USER_SYNC_SOURCE_TABLE=bi.dim_org_admin_user_info_hf
# 源表里的密码列候选名，按优先级从左到右匹配
APP_USER_SYNC_PASSWORD_COLUMNS=password_hash,password,passwd,pwd,login_password,login_pwd
APP_USER_SYNC_BATCH_SIZE=500
APP_USER_SYNC_INTERVAL_MINUTES=60

# ==================== 向量 / Embedding ====================
SENTENCE_TRANSFORMER_MODEL=/absolute/path/to/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=api
VECTOR_MONITOR_PROVIDERS=local
EMBEDDING_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
ARK_EMBEDDING_API_KEY=
ARK_API_KEY=
ARK_MODEL=
# 本地模型一般用 384，API 模型一般用 2048
EMBEDDING_DIM=384

# ==================== 连接池 / 分批配置 ====================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
MAX_TABLE_LENGTH_PER_BATCH=20000
MAX_BATCHES=5
MIN_TABLES_PER_BATCH=2

# ==================== 数据库配置 ====================
# 主要认证库 / 业务库
DB_HOLOGRES_TYPE=hologres
DB_HOLOGRES_HOST=your-hologres-host
DB_HOLOGRES_PORT=80
DB_HOLOGRES_NAME=your-db-alias
DB_HOLOGRES_USER=your-user
DB_HOLOGRES_PASSWORD=your-password
DB_HOLOGRES_DATABASE=your-database-name
DB_HOLOGRES_SCHEMA=bi
DB_HOLOGRES_SSLMODE=prefer

# 本地 MySQL 日志库（可选）
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=text_to_sql_logs
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=your_mysql_password_here

# 下面这几组是旧环境里可能还在用的额外数据源
DB_BOX_TYPE=mysql
DB_BOX_HOST=your-box-host
DB_BOX_PORT=3306
DB_BOX_NAME=your-box-db
DB_BOX_USER=your-user
DB_BOX_PASSWORD=your-password

DB_HUOMIAO_TYPE=mysql
DB_HUOMIAO_HOST=your-huomiao-host
DB_HUOMIAO_PORT=3306
DB_HUOMIAO_NAME=your-huomiao-db
DB_HUOMIAO_USER=your-user
DB_HUOMIAO_PASSWORD=your-password

DB_UK_TYPE=mysql
DB_UK_HOST=your-uk-host
DB_UK_PORT=3306
DB_UK_NAME=your-uk-db
DB_UK_USER=your-user
DB_UK_PASSWORD=your-password

# ==================== 定时任务 ====================
SCHEMA_POLL_INTERVAL=60
ENABLE_AUTO_UPDATE=true

# ==================== DataWorks / MaxCompute 知识同步 ====================
DATAWORKS_SYNC_ENABLED=1
DATAWORKS_REGION_ID=cn-beijing
DATAWORKS_PROJECT_ID=333511
# DATAWORKS_PROJECT_IDENTIFIER=your_project_identifier
DATAWORKS_ENDPOINT=https://dataworks.cn-beijing.aliyuncs.com
DATAWORKS_ACCESS_KEY_ID=your-access-key-id
DATAWORKS_ACCESS_KEY_SECRET=your-access-key-secret
DATAWORKS_SECURITY_TOKEN=
DATAWORKS_FILE_TYPES=6,10,24,1093,221,1221,225,227,228,229,230,257,258,259,260
DATAWORKS_PAGE_SIZE=100
DATAWORKS_MAX_PAGES=500
DATAWORKS_SYNC_HOUR=2
DATAWORKS_SYNC_MINUTE=0

# ==================== Git 仓库代码知识同步 ====================
BOOK_SYNC_ENABLED=1
BOOK_REPO_PATH=/home/wenba/laiqiqi/box/box_backend
BOOK_REPO_NAME=box_backend
BOOK_INCLUDE_EXTENSIONS=.py,.js,.ts,.tsx,.java,.go,.sql,.md,.yaml,.yml,.json,.sh
BOOK_EXCLUDE_DIRS=.git,node_modules,dist,build,target,venv,.venv,__pycache__
BOOK_CONTEXT_LINES=18
BOOK_MAX_FILE_SIZE=1000000
BOOK_MAX_FILES=5000
BOOK_FULL_SCAN_CANDIDATES=80
BOOK_SYNC_HOUR=1
BOOK_SYNC_MINUTE=30
