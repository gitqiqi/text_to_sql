      "match_mode": "exact",
      "sql_text": "SELECT\n  gyyk_class_id,\n  class_name AS 班级名称,\n  class_period_name AS 期别,\n  concat(grade,'年级') AS 年级,\n  tag_name AS 标签,\n  case subject when 3 then '数学' when 5 then '物理' end AS 科目,\n  host_name AS 主讲姓名,\n  class_mode_name AS 班型,\n  class_version AS 版本,\n  db_course_student_id AS 大班学员ID,\n  uid AS 学员uid,\n  phone_no AS 手机号,\n  we_user_id AS 助教企微id,\n  assistant_mobile AS 助教手机号,\n  assistant_name AS 助教姓名,\n  organ_name AS 助教年级组\nFROM bi.dim_org_class_member_hf a\nWHERE change_type IN (0, 1)\n  AND del_flag = 0\n  AND identity = 6\n  AND row_number = 1\n  AND is_valen = '正价'\n  AND tag_name = '大班'\n  AND class_period_sort = '当前学期'",
